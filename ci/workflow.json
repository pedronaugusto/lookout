{
  "land": true,
  "attest": true,
  "release": true,
  "compile_step": "install",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "x86_64-windows-msvc",
    "aarch64-windows-gnu",
    "x86_64-freebsd",
    "x86_64-netbsd"
  ],
  "compile_once": true,
  "portable_hosts": [
    "windows-latest"
  ],
  "jobs": [
    {
      "name": "ThreadSanitizer (Linux)",
      "step": "test",
      "args": ["-Dthread-sanitizer=true", "-Doptimize=debug", "-Dci-lint=false"],
      "tiers": ["release"]
    }
  ]
}
